{* Modalul global cu informarea armonizată (fișierul oficial, nemodificat) + linkul clicabil Your Europe. *}
<div class="dmlg-modal" data-dmlg-modal hidden>
    <div class="dmlg-modal__overlay" data-dmlg-close></div>
    <div class="dmlg-modal__dialog" role="dialog" aria-modal="true" aria-label="Garanția legală de conformitate">
        <button type="button" class="dmlg-modal__x" data-dmlg-close aria-label="Închide">&times;</button>
        <a href="{$dmlg_img|escape:'html':'UTF-8'}" target="_blank" rel="noopener">
            <img class="dmlg-modal__img" src="{$dmlg_img|escape:'html':'UTF-8'}" width="1654" height="2339" loading="lazy"
                 alt="Garanția legală — informarea armonizată UE privind garanția legală de conformitate de minimum doi ani">
        </a>
        <p class="dmlg-modal__caption">Mai multe informații despre drepturile tale:
            <a href="{$dmlg_ye_url|escape:'html':'UTF-8'}" target="_blank" rel="noopener">europa.eu/youreurope/garanții</a></p>
    </div>
</div>
