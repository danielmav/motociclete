{% extends 'layout.twig' %}

{% block title %}Confirmă abonarea | Newsletter Dual Motors{% endblock %}
{% block description %}Confirmă abonarea la newsletterul Dual Motors.{% endblock %}
{% block meta_robots %}noindex,nofollow{% endblock %}

{% block content %}
<article class="section">
    <div class="container container--narrow">
        <header class="page-head">
            <span class="kicker">Newsletter</span>
            <h1 class="page-title">Confirmă abonarea</h1>
        </header>
        <p class="nl-lead">
            Adresa <strong>{{ email }}</strong> va primi{% if names %}: {{ names|join(' și ') }}{% else %} newsletterul Dual Motors{% endif %}.
        </p>
        {# Confirmarea se face prin POST: filtrele de email deschid automat linkurile. #}
        <form class="nl-prefs__actions" method="post" action="{{ action }}">
            <input type="hidden" name="ok" value="1">
            <button class="btn btn--primary" type="submit">Confirmă abonarea</button>
        </form>
        <p class="finance-back"><a class="link-arrow" href="{{ base }}/">← Înapoi la showroom</a></p>
    </div>
</article>
{% endblock %}
