{# Modal global cu informarea privind garanția legală (Reg. UE 2025/1960).
   Deschis de orice [data-modal-open="garantie-legala"] (header, pagina produs, footer);
   declanșatorii sunt linkuri spre /garantia-legala → merg și fără JS. #}
<div class="modal modal--legalg" data-modal="garantie-legala" hidden>
    <div class="modal__overlay" data-modal-close></div>
    <div class="modal__dialog" role="dialog" aria-modal="true" aria-label="Garanția legală de conformitate">
        <button type="button" class="modal__x" data-modal-close aria-label="Închide">&times;</button>
        {% include 'partials/legal-guarantee-notice.twig' %}
    </div>
</div>
